bool cont = true;

void setup() {
  Serial.begin(9600);
  while (!Serial);
  SPI.begin();
  SPI.setBitOrder(MSBFIRST);
  SPI.setDataMode(SPI_MODE0);
  SPI.setClockDivider(SPI_CLOCK_DIV64); 
  pinMode(CS, OUTPUT);
  pinMode(8, OUTPUT);
  pinMode(5, INPUT);
  digitalWrite(CS, HIGH);
  digitalWrite(8, LOW);
  delay (100);
}

void loop() {
 if(digitalRead(5) & cont){
  digitalWrite(8, HIGH);
  //filldata(0x5555);
  update_write_status(enable);
  write_data();
  update_write_status(disable);
  cont = false;
  digitalWrite(8, LOW);
 }
 
}

void update_write_status(int status){
 digitalWrite(CS, LOW);
 SPI.transfer(0b10100000 | status);
 SPI.transfer(0b00000000);
 delay(1);
 digitalWrite(CS, HIGH);
}

void write_data(){
 for(int i=0; i<512; i++){
  digitalWrite(CS, LOW);
  SPI.transfer16((0b1010010<<9) | currentADDR);
  SPI.transfer16(DATA[i]);
  delay(6);
  digitalWrite(CS, HIGH);
  delay (20);
  currentADDR++;
 }
}

void filldata(int elt){
  for(int i=0; i<512; i++){
    DATA[i] = elt;
  }
}
